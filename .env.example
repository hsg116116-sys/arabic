# ══════════════════════════════════════════════════════════
#  أرض اللغة | مثال متغيرات البيئة (بدون أسرار حقيقية)
#  انسخه إلى .env وعبّئ القيم — لا تنشر .env أبداً في Git
# ══════════════════════════════════════════════════════════

# ── Supabase (قاعدة البيانات فقط — المصادقة انتقلت إلى Kinde) ──
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
SUPABASE_SECRET_KEY=sb_secret_YOUR_KEY

# ── ImageKit: التخزين السحابي (4 حسابات بتناوب تلقائي) ──
IMAGEKIT_1_ID=
IMAGEKIT_1_ENDPOINT=https://ik.imagekit.io/YOUR_ID_1
IMAGEKIT_1_PUBLIC_KEY=
IMAGEKIT_1_PRIVATE_KEY=
IMAGEKIT_2_ID=
IMAGEKIT_2_ENDPOINT=https://ik.imagekit.io/YOUR_ID_2
IMAGEKIT_2_PUBLIC_KEY=
IMAGEKIT_2_PRIVATE_KEY=
IMAGEKIT_3_ID=
IMAGEKIT_3_ENDPOINT=https://ik.imagekit.io/YOUR_ID_3
IMAGEKIT_3_PUBLIC_KEY=
IMAGEKIT_3_PRIVATE_KEY=
IMAGEKIT_4_ID=
IMAGEKIT_4_ENDPOINT=https://ik.imagekit.io/YOUR_ID_4
IMAGEKIT_4_PUBLIC_KEY=
IMAGEKIT_4_PRIVATE_KEY=

# ── GROQ: توليد أسئلة AI (3 مفاتيح بتناوب تلقائي) ──
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_MODEL=openai/gpt-oss-120b

# ── مزود AI خاص (اختياري، OpenAI-compatible) ──
# AI_API_KEY=
# AI_API_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# ── Kinde: المصادقة والتحقق من البريد (المزوّد الوحيد) ──
# التوكنات تبقى على الخادم في كوكيز httpOnly — هذا السرّ لا يوضع في VITE_ أبداً.
KINDE_ISSUER_URL=https://YOUR_TENANT.kinde.com
KINDE_CLIENT_ID=
KINDE_CLIENT_SECRET=
# عنوان العودة بعد دخول Kinde — يجب أن يطابق Allowed callback URLs حرفياً
KINDE_REDIRECT_URI=http://localhost:3000/callback
# الصفحة التي يعود إليها المستخدم بعد الدخول / الخروج
KINDE_SITE_URL=http://localhost:3000
KINDE_LOGOUT_REDIRECT_URI=http://localhost:3000
KINDE_DOMAIN=https://YOUR_TENANT.kinde.com

# ── بريد الإدارة: من يدخل بهذا البريد يُرقّى إلى معلم تلقائياً ──
ADMIN_EMAIL=

# ── الخادم ──
PORT=5000
NODE_ENV=production
