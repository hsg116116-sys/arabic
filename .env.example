# ══════════════════════════════════════════════════════════
#  أرض اللغة | مثال متغيرات البيئة (بدون أسرار حقيقية)
#  انسخه إلى .env وعبّئ القيم — لا تنشر .env أبداً في Git
# ══════════════════════════════════════════════════════════

# ── Supabase (قاعدة البيانات) ──
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
SUPABASE_SECRET_KEY=sb_secret_YOUR_KEY

# ── ImageKit: التخزين السحابي (4 حسابات بتناوب تلقائي) ──
IMAGEKIT_1_ID=
IMAGEKIT_1_ENDPOINT=https://ik.imagekit.io/YOUR_ID_1
IMAGEKIT_1_PUBLIC_KEY=
IMAGEKIT_1_PRIVATE_KEY=
IMAGEKIT_2_ID=
IMAGEKIT_2_ENDPOINT=https://ik.imagekit.io/YOUR_ID_2
IMAGEKIT_2_PUBLIC_KEY=
IMAGEKIT_2_PRIVATE_KEY=
IMAGEKIT_3_ID=
IMAGEKIT_3_ENDPOINT=https://ik.imagekit.io/YOUR_ID_3
IMAGEKIT_3_PUBLIC_KEY=
IMAGEKIT_3_PRIVATE_KEY=
IMAGEKIT_4_ID=
IMAGEKIT_4_ENDPOINT=https://ik.imagekit.io/YOUR_ID_4
IMAGEKIT_4_PUBLIC_KEY=
IMAGEKIT_4_PRIVATE_KEY=

# ── GROQ: توليد أسئلة AI (3 مفاتيح بتناوب تلقائي) ──
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_MODEL=openai/gpt-oss-120b

# ── مزود AI خاص (اختياري، OpenAI-compatible) ──
# AI_API_KEY=
# AI_API_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# ── Resend: إرسال كود تأكيد البريد (المزوّد الأساسي) ──
RESEND_API_KEY=
# onboarding@resend.dev يعمل لبريد حساب Resend فقط — أضف نطاقك للسماح للجميع
RESEND_FROM=onboarding@resend.dev
RESEND_FROM_NAME=أرض اللغة

# ── Brevo: إرسال بريد احتياطي (SMTP) ──
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
# اسم الدخول في Brevo (يظهر في صفحة SMTP & API، عادة 9de25b001@smtp-brevo.com)
BREVO_SMTP_LOGIN=
# مفتاح SMTP من Brevo (يبدأ بـ xsmtpsib-)
BREVO_SMTP_KEY=
# البريد المرسل — يجب التحقق منه في Brevo (Senders & Domains)
BREVO_MAIL_FROM=
BREVO_MAIL_FROM_NAME=أرض اللغة
# سر تشفير كوكي كود التأكيد (ولّد قيمة عشوائية طويلة)
EMAIL_VERIFY_SECRET=

# ── الخادم ──
PORT=5000
NODE_ENV=production
